    height: 8px;
}

QSpinBox::down-arrow {
    border-left: 4px solid none;
    border-right: 4px solid none;
    border-top: 5px solid #cccccc;
    width: 8px;
    height: 8px;
}

QComboBox::down-arrow {
    border-left: 4px solid none;
    border-right: 4px solid none;
    border-top: 5px solid #cccccc;
