/*=============================================================
    Dark Theme v2.0 — Improved
    Accent: #b78620 (gold)
    Основные уровни:
        bg-darkest  #131313  (поля ввода)
        bg-dark     #1e1e1e  (редакторы focus)
        bg-base     #2d2d2d  (панели, таблицы, вкладки)
        bg-mid      #3a3a3a  (основной фон QWidget)
        bg-light    #454545  (toolbar, menubar, заголовки)
        border-dim  #333333
        border      #444444
        border-lit  #555555
        text        #ffffff
        text-dim    #cccccc
        text-muted  #999999
        disabled    #656565
        accent      #b78620
=============================================================*/


/*----- QWidget (основа) -----*/
QWidget {
    background-color: #3a3a3a;
    color: #ffffff;
    selection-background-color: #b78620;
    selection-color: #000000;
}

/*----- QLabel -----*/
QLabel {
    background-color: transparent;
    color: #ffffff;
}

QLabel:disabled {
    color: #656565;
}

/*----- QMenuBar -----*/
QMenuBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(60, 60, 60, 255),
        stop:1 rgba(50, 50, 50, 255));
    border-bottom: 1px solid #333333;
    color: #ffffff;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px 10px;
    margin: 1px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: rgba(183, 134, 32, 30%);
    border: 1px solid #b78620;
}

QMenuBar::item:pressed {
    background-color: #b78620;
    color: #000000;
}

/*----- QMenu -----*/
QMenu {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(55, 55, 55, 255),
        stop:1 rgba(45, 45, 45, 255));
    border: 1px solid #333333;
    padding: 4px;
    color: #ffffff;
    margin: 0px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 28px 6px 20px;
    margin: 1px;
    border-radius: 3px;
    border: 1px solid transparent;
}

QMenu::separator {
    background-color: #444444;
    height: 1px;
    margin: 4px 10px;
}

QMenu::item:disabled {
    color: #656565;
}

QMenu::item:selected {
    background-color: rgba(183, 134, 32, 40%);
    border: 1px solid #b78620;
}

QMenu::icon {
    padding-left: 5px;
}

QMenu::right-arrow {
    image: url(icons/right_arrow.svg);
    width: 12px;
    height: 12px;
}

/*----- QToolBar -----*/
QToolBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(65, 65, 65, 255),
        stop:1 rgba(55, 55, 55, 255));
    border: none;
    border-bottom: 1px solid #333333;
    padding: 1px;
    spacing: 2px;
}

QToolBar::separator {
    background-color: #444444;
    width: 1px;
    margin: 4px 3px;
}

/*----- QToolButton -----*/
QToolButton {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 5px 8px;
    margin: 1px;
}

QToolButton:hover {
    background-color: rgba(183, 134, 32, 20%);
    border: 1px solid rgba(183, 134, 32, 50%);
}

QToolButton:pressed {
    background-color: rgba(183, 134, 32, 50%);
    border: 1px solid #b78620;
}

QToolButton:checked {
    background-color: rgba(183, 134, 32, 30%);
    border: 1px solid #b78620;
}

QToolButton:disabled {
    color: #656565;
}

/*----- QPushButton -----*/
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(80, 80, 80, 255),
        stop:1 rgba(62, 62, 62, 255));
    color: #ffffff;
    border: 1px solid #333333;
    border-radius: 3px;
    /* padding: 5px 15px; */
    min-height: 22px;
	min-width: 40px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(90, 90, 90, 255),
        stop:1 rgba(70, 70, 70, 255));
    border: 1px solid #b78620;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(60, 60, 60, 255),
        stop:1 rgba(45, 45, 45, 255));
    border: 1px solid #b78620;
}

QPushButton:checked {
    background-color: rgba(183, 134, 32, 40%);
    border: 1px solid #b78620;
}

QPushButton:disabled {
    background-color: #404040;
    color: #656565;
    border: 1px solid #333333;
}

QPushButton:flat {
    background-color: transparent;
    border: none;
    color: #ffffff;
}

QPushButton:focus {
    border: 2px solid #b78620;
    outline: none;
}

/*----- QLineEdit -----*/
QLineEdit {
    background-color: #1e1e1e;
    color: #eeeeee;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px 8px;
    selection-background-color: #b78620;
    selection-color: #000000;
}

QLineEdit:hover {
    border: 1px solid #555555;
}

QLineEdit:focus {
    border: 1px solid #b78620;
    background-color: #1a1a1a;
}

QLineEdit:disabled {
    background-color: #2a2a2a;
    color: #656565;
    border: 1px solid #3a3a3a;
}

QLineEdit:read-only {
    background-color: #2a2a2a;
    color: #cccccc;
    border: 1px solid #3a3a3a;
}

/*----- QPlainTextEdit -----*/
QPlainTextEdit {
    background-color: #1e1e1e;
    color: #eeeeee;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px;
    selection-background-color: #b78620;
    selection-color: #000000;
}

QPlainTextEdit:hover {
    border: 1px solid #555555;
}

QPlainTextEdit:focus {
    border: 1px solid #b78620;
    background-color: #1a1a1a;
}

QPlainTextEdit:disabled {
    background-color: #2a2a2a;
    color: #656565;
    border: 1px solid #3a3a3a;
}

/*----- QTextEdit & QTextBrowser -----*/
QTextEdit,
QTextBrowser {
    background-color: #1e1e1e;
    color: #eeeeee;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px;
    selection-background-color: #b78620;
    selection-color: #000000;
}

QTextEdit:hover,
QTextBrowser:hover {
    border: 1px solid #555555;
}

QTextEdit:focus,
QTextBrowser:focus {
    border: 1px solid #b78620;
    background-color: #1a1a1a;
}

QTextEdit:disabled,
QTextBrowser:disabled {
    background-color: #2a2a2a;
    color: #656565;
    border: 1px solid #3a3a3a;
}

/*----- QTabWidget -----*/
QTabWidget::pane {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-top: none;
    border-radius: 0 0 3px 3px;
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
}

/*----- QTabBar -----*/
QTabBar::tab {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(70, 70, 70, 255),
        stop:1 rgba(55, 55, 55, 255));
    color: #cccccc;
    border: 1px solid #444444;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 6px 12px;
    margin-right: 1px;
    min-width: 60px;
}

QTabBar::tab:selected {
    background-color: #2d2d2d;
    color: #ffffff;
    border-color: #444444;
    border-bottom-color: #2d2d2d;
    padding-top: 7px;
    margin-top: -1px;
}

QTabBar::tab:!selected {
    background-color: #404040;
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #505050;
    border-color: #555555;
    color: #ffffff;
}

QTabBar::tab:selected:hover {
    background-color: #353535;
}

QTabBar::tab:disabled {
    background-color: #303030;
    color: #656565;
}

/* North tab alignment */
QTabBar::tab {
    padding: 6px 12px;
}

/*----- QComboBox -----*/
QComboBox {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(75, 75, 75, 255),
        stop:1 rgba(60, 60, 60, 255));
    border: 1px solid #333333;
    border-radius: 3px;
    color: #ffffff;
    min-height: 22px;
    /* padding: 2px 8px 2px 6px; */
}

QComboBox:hover {
    border: 1px solid #555555;
}

QComboBox:focus {
    border: 1px solid #b78620;
}

QComboBox:on {
    background-color: #b78620;
    color: #000000;
}

QComboBox::drop-down {
    background-color: transparent;
    border-left: 1px solid #444444;
    border-radius: 0 2px 2px 0;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QComboBox::down-arrow {
    image: url(icons/down_arrow.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #383838;
    color: #ffffff;
    border: 1px solid #333333;
    selection-background-color: #b78620;
    selection-color: #000000;
    outline: none;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    padding: 5px 8px;
    border-radius: 2px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #b78620;
    color: #000000;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(183, 134, 32, 30%);
}

QComboBox:disabled {
    background-color: #404040;
    color: #656565;
    border-color: #333333;
}

QComboBox::editable {
    background-color: #1e1e1e;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 2px 6px;
}

QComboBox::editable:focus {
    border: 1px solid #b78620;
}

/*----- QSpinBox & QDoubleSpinBox & QDateTimeEdit -----*/
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #1e1e1e;
    color: #eeeeee;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 4px 8px;
    padding-right: 0;
    min-height: 22px;
    selection-background-color: #b78620;
    selection-color: #000000;
}

QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover {
    border: 1px solid #555555;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus {
    border: 1px solid #b78620;
    background-color: #1a1a1a;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button {
    background-color: #505050;
    border: 1px solid #444444;
    border-left: none;
    border-radius: 0 3px 0 0;
    width: 18px;
    subcontrol-origin: border;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: #505050;
    border: 1px solid #444444;
    border-left: none;
    border-top: none;
    border-radius: 0 0 3px 0;
    width: 18px;
    subcontrol-origin: border;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #606060;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDateTimeEdit::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed,
QDateTimeEdit::down-button:pressed {
    background-color: #b78620;
    border-color: #b78620;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(icons/up_arrow.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(icons/down_arrow.svg);
    width: 10px;
    height: 10px;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled {
    background-color: #2a2a2a;
    color: #656565;
    border-color: #3a3a3a;
}

/*----- QGroupBox -----*/
QGroupBox {
    background-color: rgba(0, 0, 0, 15%);
    border: 1px solid #444444;
    border-radius: 5px;
    margin-top: 18px;
    padding: 14px 8px 8px 8px;
    font-weight: bold;
}

QGroupBox::title {
    background-color: #3a3a3a;
    color: #eeeeee;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    margin-left: 10px;
    margin-top: -8px;
    border-radius: 3px;
}

/*----- QHeaderView -----*/
QHeaderView::section {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(65, 65, 65, 255),
        stop:1 rgba(55, 55, 55, 255));
    border: none;
    border-right: 1px solid #444444;
    border-bottom: 1px solid #333333;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
}

QHeaderView::section:first {
    border-top-left-radius: 3px;
}

QHeaderView::section:last {
    border-top-right-radius: 3px;
}

QHeaderView::section:checked {
    background-color: #b78620;
    color: #000000;
}

QHeaderView::section:hover {
    background-color: rgba(183, 134, 32, 25%);
}

/*----- QTreeWidget -----*/
QTreeWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 3px;
    alternate-background-color: #333333;
    show-decoration-selected: 1;
    selection-background-color: #3a3a3a; /*Поле слева от текста*/
    selection-color: #000000;
    outline: none;
}

QTreeWidget::item {
    padding: 4px 2px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 4%);
}

QTreeWidget::item:selected {
    background-color: #b78620;
    color: #000000;
}

QTreeWidget::item:hover:!selected {
    background-color: rgba(183, 134, 32, 15%);
}

QTreeWidget::branch {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:hover {
    background-color: transparent;
}

QTreeWidget::branch:selected {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: none;
}

/*----- QTreeView -----*/
QTreeView {
    show-decoration-selected: 1;
    paint-alternating-row-colors-for-empty-area: 1;
    background-color: transparent;
    alternate-background-color: #333333;
    color: #ffffff;
    border: none;
    outline: none;
}

QTreeView::item:hover:!selected {
    background-color: rgba(183, 134, 32, 15%);
}

QTreeView::item:selected {
    background-color: rgba(183, 134, 32, 40%);
    color: #ffffff;
}

/* Убираем выделение левой области (где отступы и стрелки) */
QTreeView::branch {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeView::branch:hover {
    background-color: #3a3a3a; /* это точно уберает часть ховера слева от текста*/
}

QTreeView::branch:selected {
    background-color: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    background-color: #3a3a3a;     /* чиним 3ю вложеность */           
    image: none;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    background-color: #3a3a3a;		/* чиним 1-2ю вложеность */
    image: none;
}

/*----- QListView & QListWidget -----*/
QListView,
QListWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 3px;
    alternate-background-color: #333333;
    outline: none;
}

QListView::item,
QListWidget::item {
    padding: 6px 8px;
    border: none;
    border-radius: 2px;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: #b78620;
    color: #000000;
}

QListView::item:hover:!selected,
QListWidget::item:hover:!selected {
    background-color: rgba(183, 134, 32, 15%);
}

/*----- QTableView & QTableWidget -----*/
QTableView,
QTableWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 3px;
    alternate-background-color: #333333;
    gridline-color: #3a3a3a;
    outline: none;
    selection-background-color: #b78620;
    selection-color: #000000;
}

QTableView::item,
QTableWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #b78620;
    color: #000000;
}

QTableView::item:hover:!selected,
QTableWidget::item:hover:!selected {
    background-color: rgba(183, 134, 32, 15%);
}

/*----- QCheckBox -----*/
QCheckBox {
    background-color: transparent;
    color: #eeeeee;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #555555;
    border-radius: 3px;
    background-color: #2d2d2d;
}

QCheckBox::indicator:hover {
    border: 1px solid #b78620;
    background-color: #353535;
}

QCheckBox::indicator:checked {
    /* background-color: #b78620; */
    border: 1px solid #f76628;
    image: url(icons/check.svg);
}

QCheckBox::indicator:indeterminate {
    background-color: #808080;
    border: 1px solid #808080;
}

QCheckBox:disabled {
    color: #656565;
}

QCheckBox::indicator:disabled {
    background-color: #404040;
    border: 1px solid #555555;
}
/*
/*----- QRadioButton -----*/
QRadioButton {
    background-color: transparent;
    color: #eeeeee;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #555555;
    border-radius: 8px;
    background-color: #2d2d2d;
}

QRadioButton::indicator:hover {
    border: 1px solid #b78620;
    background-color: #353535;
}

QRadioButton::indicator:checked {
    border: 4px solid #b78620;
    background-color: #2d2d2d;
}

QRadioButton:disabled {
    color: #656565;
}

QRadioButton::indicator:disabled {
    background-color: #404040;
    border: 1px solid #555555;
}

/*----- QSlider -----*/
QSlider::groove:horizontal {
    background-color: #2d2d2d;
    height: 6px;
    border-radius: 3px;
    border: 1px solid #3a3a3a;
}

QSlider::sub-page:horizontal {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b78620,
        stop:1 #d4a030);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background-color: #404040;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #ffffff;
    border: 2px solid #b78620;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #b78620;
    border: 2px solid #ffffff;
}

/* Vertical Slider */
QSlider::groove:vertical {
    background-color: #2d2d2d;
    width: 6px;
    border-radius: 3px;
    border: 1px solid #3a3a3a;
}

QSlider::sub-page:vertical {
    background-color: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #b78620,
        stop:1 #d4a030);
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background-color: #404040;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: #ffffff;
    border: 2px solid #b78620;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background-color: #b78620;
    border: 2px solid #ffffff;
}

/* Tick marks */
QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background-color: #2d2d2d;
    border-color: #333333;
}

QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background-color: #656565;
    border-color: #555555;
}

/*----- QScrollBar -----*/
QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar::groove:horizontal {
    background-color: #2d2d2d;
    height: 6px;
    border-radius: 3px;
    margin: 3px 0;
}

QScrollBar::groove:vertical {
    background-color: #2d2d2d;
    width: 6px;
    border-radius: 3px;
    margin: 0 3px;
}

QScrollBar::handle:horizontal {
    background-color: #606060;
    min-width: 30px;
    border-radius: 3px;
    margin: 1px 0;
}

QScrollBar::handle:vertical {
    background-color: #606060;
    min-height: 30px;
    border-radius: 3px;
    margin: 0 1px;
}

QScrollBar::handle:hover {
    background-color: #b78620;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background-color: transparent;
    border: none;
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
}

/*----- QProgressBar -----*/
QProgressBar {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 5px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(247, 102, 40, 255),
        stop:1 rgba(183, 134, 32, 255));
    border-radius: 4px;
}

QProgressBar::chunk:disabled {
    background-color: #404040;
}

/*----- QSplitter -----*/
QSplitter::handle {
    background-color: #444444;
}

QSplitter::handle:hover {
    background-color: #b78620;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/*----- QFrame -----*/
QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="4"] { /* HLine */
    background-color: #444444;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background-color: #444444;
    max-width: 1px;
}

/*----- QDockWidget -----*/
QDockWidget {
    background-color: #3a3a3a;
    border: 1px solid #444444;
    border-radius: 3px;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(55, 55, 55, 255),
        stop:1 rgba(48, 48, 48, 255));
    padding: 6px;
    border-radius: 3px 3px 0 0;
    border-bottom: 1px solid #333333;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
    border-radius: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: rgba(183, 134, 32, 30%);
}

/*----- QStatusBar -----*/
QStatusBar {
    background-color: #2d2d2d;
    color: #cccccc;
    border-top: 1px solid #444444;
}

QStatusBar::item {
    border: none;
}

QStatusBar::item:not(:last-child) {
    border-right: 1px solid #444444;
}

QStatusBar QLabel {
    padding: 0 4px;
}

/*----- QMessageBox -----*/
QMessageBox {
    background-color: #3a3a3a;
}

QMessageBox QLabel {
    color: #ffffff;
    background-color: transparent;
}

QMessageBox QPushButton {
    min-width: 100px;
	min-height: 32px;
    /* padding: 5px 20px; */
}

/*----- QDialog -----*/
QDialog {
    background-color: #3a3a3a;
}

/*----- QScrollArea -----*/
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollArea::corner {
    background-color: #2d2d2d;
    border: 1px solid #444444;
}

/*----- QCalendarWidget -----*/
QCalendarWidget {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 3px;
}

QCalendarWidget QTableView {
    background-color: transparent;
    alternate-background-color: #333333;
    selection-background-color: #b78620;
    selection-color: #000000;
    border: none;
}

QCalendarWidget QHeaderView {
    background-color: transparent;
}

QCalendarWidget QHeaderView::section {
    background-color: #404040;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 2px;
    padding: 4px;
}

QCalendarWidget QAbstractItemView {
    background-color: transparent;
    color: #ffffff;
    selection-background-color: #b78620;
    selection-color: #000000;
    outline: none;
}

QCalendarWidget QWidget {
    color: #ffffff;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: rgba(183, 134, 32, 25%);
}

QCalendarWidget QMenu {
    background-color: #383838;
    border: 1px solid #444444;
}

QCalendarWidget QMenu::item:selected {
    background-color: #b78620;
    color: #000000;
}

/*----- QSizeGrip -----*/
QSizeGrip {
    width: 12px;
    height: 12px;
    image: none;
}

/*----- QToolTip -----*/
QToolTip {
    background-color: #1e1e1e;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 8px;
}

/*----- QWizard -----*/
QWizard {
    background-color: #3a3a3a;
}

QWizard QGroupBox {
    background-color: rgba(0, 0, 0, 10%);
}

/*----- QLCDNumber -----*/
QLCDNumber {
    background-color: #131313;
    color: #b78620;
    border: 1px solid #444444;
    border-radius: 3px;
}

/*----- QSpinBox::up-arrow / down-arrow fallback (без SVG) -----*/
/* Если SVG-иконки не найдены, можно раскомментировать стиль ниже */
