/* ==========================================
   QSS Стиль: Astra Linux (Fly DE) Theme
   ========================================== */

/* Базовые настройки шрифтов и фонов */
QWidget {
    font-family: "DejaVu Sans", "Liberation Sans", sans-serif;
    font-size: 12px;
    color: #000000;
    background-color: #e8e8e8; /* Стандартный серый фон Fly */
}

/* Главные окна и диалоги (с строгой синей рамкой) */
QMainWindow, QDialog {
    background-color: #e8e8e8;
    border: 1px solid #1e3a5f; /* Фирменный темный синий Astra */
}

/* --- МЕНЮ И ПАНЕЛЬ ИНСТРУМЕНТОВ --- */
QMenuBar {
    background-color: #2c5282; /* Темно-синий фон панели */
    color: #ffffff;
    border-bottom: 1px solid #1a365d;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 0px;
}

QMenuBar::item:selected {
    background-color: #1e3a5f; /* Более темный синий при наведении */
}

QMenu {
    background-color: #f0f0f0;
    border: 1px solid #1e3a5f;
    padding: 2px;
}

QMenu::item {
    padding: 4px 25px 4px 20px;
    border: 1px solid transparent;
}

QMenu::item:selected {
    background-color: #4a90e2; /* Голубой выделение Astra */
    color: white;
    border-color: #2c5282;
}

QMenu::separator {
    height: 1px;
    background: #c0c0c0;
    margin: 4px 2px;
}

/* --- КНОПКИ --- */
QPushButton {
    background-color: #2c5282;
    color: #ffffff;
    border: 1px solid #1a365d;
    padding: 5px 15px;
    border-radius: 2px; /* Минимальное скругление */
    min-width: 80px;
}

QPushButton:hover {
    background-color: #3b6fa0;
    border-color: #2c5282;
}

QPushButton:pressed {
    background-color: #1e3a5f;
}

QPushButton:disabled {
    background-color: #a0a0a0;
    color: #606060;
    border-color: #808080;
}

/* --- ПОЛЯ ВВОДА --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #808080;
    padding: 3px;
    border-radius: 0px; /* Строго прямоугольные */
    selection-background-color: #4a90e2; /* Голубое выделение текста */
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #2c5282; /* Синяя рамка при фокусе */
}

/* --- ВЫПАДАЮЩИЕ СПИСКИ --- */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #808080;
    padding: 3px;
    border-radius: 0px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #808080;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #333333;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #1e3a5f;
    selection-background-color: #4a90e2;
    selection-color: white;
    outline: none;
}

/* --- ЧЕКБОКСЫ И РАДИОКНОПКИ --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #000000;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #808080;
    background-color: #ffffff;
    border-radius: 0px; /* Квадратные чекбоксы в стиле Fly */
}

QRadioButton::indicator {
    border-radius: 8px; /* Круглые радиокнопки */
}

QCheckBox::indicator:checked {
    background-color: #2c5282;
    border-color: #1a365d;
    image: url(); /* Оставляем пустым, используем цвет */
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2c5282;
    border-color: #1a365d;
}

/* --- ВКЛАДКИ --- */
QTabWidget::pane {
    border: 1px solid #1e3a5f;
    top: -1px;
    background-color: #e8e8e8;
}

QTabBar::tab {
    background-color: #d0d0d0;
    border: 1px solid #808080;
    border-bottom: none;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    color: #333333;
}

QTabBar::tab:selected {
    background-color: #e8e8e8;
    border-color: #1e3a5f;
    border-bottom: 2px solid #e8e8e8; /* Скрыть нижнюю границу, слить с панелью */
    font-weight: bold;
    color: #000000;
}

QTabBar::tab:hover:!selected {
    background-color: #e0e0e0;
}

/* --- ТАБЛИЦЫ --- */
QTableView, QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f5f5f5;
    gridline-color: #c0c0c0;
    border: 1px solid #808080;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
    border-radius: 0px;
}

QHeaderView::section {
    background-color: #d8d8d8;
    border: 1px solid #a0a0a0;
    padding: 4px;
    font-weight: bold;
    border-radius: 0px;
}

/* --- СКРОЛЛБАРЫ (Строгие, без стрелок) --- */
QScrollBar:vertical {
    background: #e0e0e0;
    width: 14px;
    border: 1px solid #c0c0c0;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #a0a0a0;
    min-height: 30px;
    border: 1px solid #808080;
}

QScrollBar::handle:vertical:hover {
    background: #808080;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; /* Убираем стрелки */
}

QScrollBar:horizontal {
    background: #e0e0e0;
    height: 14px;
    border: 1px solid #c0c0c0;
}

QScrollBar::handle:horizontal {
    background: #a0a0a0;
    min-width: 30px;
    border: 1px solid #808080;
}

QScrollBar::handle:horizontal:hover {
    background: #808080;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px; /* Убираем стрелки */
}

/* --- СТАТУС БАР --- */
QStatusBar {
    background-color: #d0d0d0;
    border-top: 1px solid #a0a0a0;
    color: #333333;
}

/* --- ГРУППИРОВКИ --- */
QGroupBox {
    border: 1px solid #808080;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #1e3a5f; /* Фирменный синий для заголовков групп */
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* --- ПРОГРЕСС-БАР --- */
QProgressBar {
    border: 1px solid #808080;
    border-radius: 0px;
    text-align: center;
    background-color: #e0e0e0;
    color: #000000;
}

QProgressBar::chunk {
    background-color: #2c5282; /* Полоска загрузки синяя */
}

/* --- ТУЛТИПЫ (Подсказки) --- */
QToolTip {
    background-color: #ffffe1;
    color: #000000;
    border: 1px solid #000000;
    padding: 2px;
}